# Google Gemini API Key (Optional if passed via X-Gemini-API-Key UI header or using Resilient Coordinator Fallback)
GEMINI_API_KEY=

# Ordered 5-model cascade (Gemini 3 series prioritized)
GEMINI_MODEL_CASCADE=gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-2.5-pro,gemini-2.5-flash

# SQLite Database URL
DATABASE_URL=sqlite:///./partyplanner.db
